# Backend environment example

# Redis for cross-instance WebSocket and collaboration pub/sub
COLLAB_REDIS_URL=redis://localhost:6379
# Optional: TLS and password
# COLLAB_REDIS_TLS=true
# COLLAB_REDIS_PASSWORD=supersecret

# Optional: reuse same Redis for generic WS bridge
# WS_REDIS_URL=redis://localhost:6379

# JWT secret for WebSocket auth (set in production)
# WS_JWT_SECRET=change-me

# Comma-separated list of allowed frontend origins
# FRONTEND_URLS=http://localhost:3000
