# Supabase Configuration
# Get these values from: https://supabase.com/dashboard/project/_/settings/api
# Copy this file to .env.local and fill in your actual values

NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_DISABLE_COLLAB=1
NEXT_PUBLIC_COLLAB_LOGGING=0

# Optional LAN/host overrides (only needed if you want to bypass Next.js rewrites)
# NEXT_PUBLIC_API_URL=http://<YOUR_PC_IP>:8000
# NEXT_PUBLIC_FILE_SYSTEM_URL=http://<YOUR_PC_IP>:3001
# NEXT_PUBLIC_WS_URL=ws://<YOUR_PC_IP>:3001
