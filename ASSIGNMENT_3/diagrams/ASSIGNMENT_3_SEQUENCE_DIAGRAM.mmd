%%{init: {'theme':'base', 'themeVariables': { 'primaryColor':'#e8f4f8', 'primaryTextColor':'#2c3e50', 'primaryBorderColor':'#3498db', 'lineColor':'#3498db', 'secondaryColor':'#f0f9ff', 'tertiaryColor':'#e0f2fe', 'noteBkgColor':'#fff7ed', 'noteTextColor':'#2c3e50', 'noteBorderColor':'#f59e0b', 'activationBkgColor':'#dbeafe', 'activationBorderColor':'#3b82f6'}}}%%
sequenceDiagram
    actor User
    participant UI as VersionHistoryPanel
    participant CM as CommandManager
    participant Cmd as RestoreVersionCommand
    participant FSS as FileSystemService
    participant MinIO as MinIO
    participant VRM as VersionRetentionManager
    participant Strategy as RetentionStrategy

    rect rgb(240, 248, 255)
        Note over User,Strategy: View Version History
    end
    User->>UI: Click "Version History"
    UI->>FSS: GET /api/projects/{projectId}/files/versions?path={filePath}
    FSS->>MinIO: listObjects(..., {IncludeVersion: true})
    MinIO-->>FSS: Versions
    FSS-->>UI: {versions: [...]}
    UI-->>User: Display timeline

    rect rgb(240, 253, 244)
        Note over UI,CM: Restore Version (Command Pattern)
    end
    User->>UI: Click "Restore"
    UI->>Cmd: new RestoreVersionCommand(...)
    UI->>CM: execute(command)
    
    rect rgb(255, 247, 237)
        Note over CM,Cmd: Template Method Pattern
    end
    CM->>Cmd: execute() → doExecute()
    
    rect rgb(240, 253, 244)
        Note over Cmd,MinIO: Memento: Save state for undo
    end
    Cmd->>FSS: Get current version & content
    FSS->>MinIO: getObject(...)
    MinIO-->>FSS: Current content
    FSS-->>Cmd: {previousVersionId, previousContent}
    
    Cmd->>FSS: Restore to target version
    FSS->>MinIO: getObject(..., {versionId})
    MinIO-->>FSS: Old version content
    FSS->>MinIO: putObject(...)
    MinIO-->>FSS: Success (new version)
    FSS-->>Cmd: {success: true}
    Cmd-->>CM: Success
    CM->>CM: Push to undoStack
    CM-->>UI: Complete
    UI-->>User: "File restored!"

    rect rgb(240, 248, 255)
        Note over User,Strategy: Undo Restore
    end
    User->>UI: Press Ctrl+Z
    UI->>CM: undo()
    CM->>Cmd: undo() → doUndo()
    
    rect rgb(240, 253, 244)
        Note right of Cmd: Memento: Restore from saved state
    end
    Cmd->>FSS: Restore to previousVersionId
    FSS->>MinIO: putObject(...)
    MinIO-->>FSS: Success
    FSS-->>Cmd: {success: true}
    Cmd-->>CM: Undo complete
    CM->>CM: Push to redoStack
    CM-->>UI: Success
    UI-->>User: "Restore undone"

    rect rgb(240, 248, 255)
        Note over VRM,Strategy: Apply Retention Policy (Strategy Pattern)
    end
    VRM->>FSS: listFileVersions()
    FSS->>MinIO: listObjects(..., {IncludeVersion: true})
    MinIO-->>FSS: All versions
    FSS-->>VRM: {versions: [...]}
    VRM->>Strategy: filterVersionsToKeep(versions)
    Strategy-->>VRM: versionsToKeep[]
    
    loop For each version to delete
        VRM->>FSS: deleteFileVersion(versionId)
        FSS->>MinIO: removeObject(..., {versionId})
        MinIO-->>FSS: Deleted
    end
