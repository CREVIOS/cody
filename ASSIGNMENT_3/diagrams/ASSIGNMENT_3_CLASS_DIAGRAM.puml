@startuml File Version History - Class Diagram
!theme plain
skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam packageStyle rectangle

package "Frontend - Command Pattern" {
    interface Command {
        +execute(): Promise<void>
        +undo(): Promise<void>
        +redo(): Promise<void>
        +canUndo(): boolean
        +getDescription(): string
        +serialize(): CommandData
    }

    abstract class BaseCommand {
        #executed: boolean
        #timestamp: number
        #userId: string
        #projectId: string
        --
        +execute(): Promise<void>
        +undo(): Promise<void>
        +redo(): Promise<void>
        --
        #doExecute(): Promise<void> {abstract}
        #doUndo(): Promise<void> {abstract}
        +canUndo(): boolean {abstract}
        +getDescription(): string {abstract}
    }

    class RestoreVersionCommand {
        -previousContent: string
        -restoredContent: string
        -filePath: string
        -targetVersionId: string
        -versionService: VersionService
        -onContentUpdate: Function
        --
        +doExecute(): Promise<void>
        +doUndo(): Promise<void>
        +doRedo(): Promise<void>
        +getDescription(): string
        +canUndo(): boolean
        +serialize(): CommandData
    }

    class CommandManager {
        -commandStack: Command[]
        -redoStack: Command[]
        -maxStackSize: number
        --
        +execute(command: Command): Promise<void>
        +undo(): Promise<void>
        +redo(): Promise<void>
        +canUndo(): boolean
        +canRedo(): boolean
        +getHistory(): Command[]
    }

    class VersionHistoryPanel {
        -versions: FileVersion[]
        -selectedVersion: string
        -loading: boolean
        -error: string
        --
        +loadVersions(): Promise<void>
        +loadVersionContent(versionId): Promise<void>
        +handleRestore(versionId): Promise<void>
        +formatDate(date): string
        +formatSize(bytes): number
    }

    Command <|.. BaseCommand : implements
    BaseCommand <|-- RestoreVersionCommand : extends
    CommandManager o-- Command : manages
    VersionHistoryPanel ..> RestoreVersionCommand : creates
}

package "Backend - Strategy Pattern" {
    abstract class IRetentionStrategy {
        +filterVersionsToKeep(versions: Version[]): Version[] {abstract}
        +getName(): string {abstract}
    }

    class KeepRecentVersionsStrategy {
        -maxVersions: number
        --
        +filterVersionsToKeep(versions): Version[]
        +getName(): string
    }

    class TimeBasedRetentionStrategy {
        -keepAllHours: number
        -keepDailyDays: number
        -keepWeeklyDays: number
        --
        +filterVersionsToKeep(versions): Version[]
        +getName(): string
        -getWeekKey(date): string
        -getWeekNumber(date): number
    }

    class TaggedVersionsStrategy {
        +filterVersionsToKeep(versions): Version[]
        +getName(): string
    }

    class VersionRetentionManager {
        -fileSystemService: FileSystemService
        -strategy: IRetentionStrategy
        --
        +setStrategy(strategy): void
        +applyRetentionPolicy(projectId, filePath): Promise
        +applyRetentionPolicyToProject(projectId): Promise
    }

    IRetentionStrategy <|-- KeepRecentVersionsStrategy : implements
    IRetentionStrategy <|-- TimeBasedRetentionStrategy : implements
    IRetentionStrategy <|-- TaggedVersionsStrategy : implements
    VersionRetentionManager o-- IRetentionStrategy : uses
}

package "Backend - Service Layer" {
    class FileSystemService {
        -minioClient: MinIO.Client
        -bucketName: string
        --
        +listFileVersions(projectId, filePath): Promise
        +getFileVersion(projectId, filePath, versionId): Promise
        +restoreFileVersion(projectId, filePath, versionId): Promise
        +deleteFileVersion(projectId, filePath, versionId): Promise
        +getVersioningStatus(): Promise
        +enableVersioning(): Promise
        --
        +createFile(projectId, filePath, content): Promise
        +updateFile(projectId, filePath, content): Promise
        +readFile(projectId, filePath): Promise
        +deleteItem(projectId, path): Promise
    }

    VersionRetentionManager ..> FileSystemService : uses
}

package "Storage - Memento Pattern (Conceptual)" {
    class MinIOVersion <<Memento>> {
        +versionId: string
        +isLatest: boolean
        +lastModified: Date
        +size: number
        +etag: string
        +isDeleteMarker: boolean
        --
        <<immutable>>
        <<generated by MinIO>>
    }

    class MinIOClient <<External Library>> {
        +listObjects(bucket, prefix, recursive, options): Stream
        +getObject(bucket, object, options): Stream
        +putObject(bucket, object, stream): Promise
        +removeObject(bucket, object, options): Promise
        +setBucketVersioning(bucket, config): Promise
        +getBucketVersioning(bucket): Promise
    }

    FileSystemService o-- MinIOClient : uses
    FileSystemService ..> MinIOVersion : creates/manages
}

package "Data Transfer Objects" {
    class FileVersion {
        +versionId: string
        +isLatest: boolean
        +lastModified: string
        +size: number
        +etag: string
        +isDeleteMarker: boolean
    }

    class FileSystemItem {
        +name: string
        +path: string
        +type: 'file' | 'folder'
        +size: number
        +lastModified: Date
    }

    VersionHistoryPanel ..> FileVersion : displays
    VersionHistoryPanel ..> FileSystemItem : for
}

' Cross-package relationships
RestoreVersionCommand ..> FileSystemService : calls via VersionService interface
VersionHistoryPanel ..> FileSystemService : calls via REST API

' Notes
note right of BaseCommand
  **Template Method Pattern**
  - execute() defines skeleton
  - Subclasses implement doExecute()
  - Ensures consistent execution flow
end note

note right of IRetentionStrategy
  **Strategy Pattern**
  - Define family of algorithms
  - Make them interchangeable
  - Select at runtime
end note

note right of MinIOVersion
  **Memento Pattern (Conceptual)**
  - MinIO versions are mementos
  - Immutable state snapshots
  - Unique version ID
  - Opaque to application
end note

note bottom of RestoreVersionCommand
  **Command Pattern**
  - Encapsulates restore as object
  - Supports undo/redo
  - Stores state for reversal
  - Integrates with CommandManager
end note

@enduml
