%%{init: {'theme':'base', 'themeVariables': { 'primaryColor':'#e8f4f8', 'primaryTextColor':'#2c3e50', 'primaryBorderColor':'#3498db', 'lineColor':'#3498db', 'secondaryColor':'#f0f9ff', 'tertiaryColor':'#e0f2fe', 'noteBkgColor':'#fff7ed', 'noteTextColor':'#2c3e50', 'noteBorderColor':'#f59e0b', 'activationBkgColor':'#dbeafe', 'activationBorderColor':'#3b82f6'}}}%%
sequenceDiagram
    actor User
    participant UI as VersionHistoryPanel
    participant CM as CommandManager
    participant Cmd as RestoreVersionCommand
    participant FSS as FileSystemService
    participant MinIO as MinIO

    rect rgb(240, 248, 255)
        Note over User,MinIO: Restore Version (Command + Template Method + Memento)
    end

    User->>UI: Select version and click "Restore"
    activate UI

    UI->>Cmd: new RestoreVersionCommand(...)
    deactivate UI
    activate Cmd
    deactivate Cmd

    UI->>CM: execute(restoreCommand)
    activate UI
    activate CM

    CM->>Cmd: execute()
    activate Cmd

    rect rgb(255, 247, 237)
        Note right of Cmd: Template Method Pattern<br/>BaseCommand.execute() orchestrates<br/>and calls doExecute() hook
    end

    Cmd->>Cmd: doExecute()
    activate Cmd

    Cmd->>FSS: listVersions()
    activate FSS
    FSS-->>Cmd: versions[]
    deactivate FSS

    Cmd->>FSS: getCurrentContent()
    activate FSS
    FSS->>MinIO: getObject()
    activate MinIO
    MinIO-->>FSS: Current content stream
    deactivate MinIO
    FSS-->>Cmd: {success: true, content: "current..."}
    deactivate FSS

    rect rgb(240, 253, 244)
        Note right of Cmd: Memento Pattern<br/>Save current state for undo capability
    end

    Cmd->>Cmd: this.previousContent = "current..."
    deactivate Cmd

    Cmd->>FSS: getVersion(versionId)
    activate FSS
    FSS->>MinIO: getObject(versionId)
    activate MinIO
    MinIO-->>FSS: Old version content
    deactivate MinIO
    FSS-->>Cmd: {success: true, content: "old..."}
    deactivate FSS

    Cmd->>FSS: restoreVersion(versionId)
    activate FSS
    FSS->>MinIO: putObject(content)
    activate MinIO
    rect rgb(255, 247, 237)
        Note right of MinIO: MinIO creates NEW version<br/>with old content<br/>(Versioning is automatic)
    end
    MinIO-->>FSS: Success, new versionId
    deactivate MinIO
    FSS-->>Cmd: {success: true, message: "Restored"}
    deactivate FSS

    Cmd->>Cmd: this.executed = true
    Cmd-->>CM: Command executed successfully
    deactivate Cmd

    CM->>CM: Push to command stack
    CM-->>UI: Execution complete
    deactivate CM

    UI->>UI: Refresh file content
    UI-->>User: UI updates with restored content
    deactivate UI
