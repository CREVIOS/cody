    class BaseAPITemplate~TResponse~ {
      <<abstract>>
      +execute() Promise~TResponse~
      --
      #buildURL() string*
      #buildOptions() RequestInit*
      #performRequest(url: string, options: RequestInit) Promise~Response~
      #parseResponse(res: Response) Promise~TResponse~
      #onSuccess(data: TResponse, res: Response) void
      #onError(message: string, res: Response) Promise~void~
      #getErrorMessage(res: Response) Promise~string~
      --
      #getBaseURL() string
      #invalidateCache(pattern: string) void
    }

    class BaseAPITemplateWithUser~TResponse~ {
      <<abstract>>
      -userId: string
      #performRequest(url: string, options: RequestInit) Promise~Response~
    }

    class BaseAPITemplateSilentFail~TResponse~ {
      <<abstract>>
      +execute() Promise~TResponse~
      #getFallbackValue() TResponse*
    }

