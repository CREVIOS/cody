```mermaid
classDiagram
    direction TB
    
    %% Memento Pattern Components for MinIO Versioning
    
    class FileContent {
        <<Originator>>
        -projectId: string
        -filePath: string
        -content: string
        -currentVersionId: string
        +getContent() string
        +setContent(content: string) void
        +getCurrentVersionId() string
    }
    
    class FileVersion {
        <<Memento>>
        +versionId: string
        +isLatest: boolean
        +lastModified: Date
        +size: number
        +etag: string
        +isDeleteMarker: boolean
        +content: string
        +metadata: object
    }
    
    class MinIOStorageAdapter {
        <<Caretaker>>
        -bucketName: string
        -minioClient: Minio.Client
        +getVersions(projectId: string, filePath: string) Promise~FileVersion[]~
        +getVersion(projectId: string, filePath: string, versionId: string) Promise~FileVersion~
        +restoreVersion(projectId: string, filePath: string, versionId: string) Promise~void~
        +deleteVersion(projectId: string, filePath: string, versionId: string) Promise~void~
        +writeFile(projectId: string, filePath: string, content: string) Promise~object~
        +readFile(projectId: string, filePath: string, options?: object) Promise~string~
        +getVersioningStatus() Promise~object~
        +enableVersioning() Promise~object~
    }
    
    class FileSystemService {
        <<Client>>
        -storage: StorageAdapter
        +listFileVersions(projectId: string, filePath: string) Promise~FileVersion[]~
        +getFileVersion(projectId: string, filePath: string, versionId: string) Promise~FileVersion~
        +restoreFileVersion(projectId: string, filePath: string, versionId: string) Promise~void~
        +deleteFileVersion(projectId: string, filePath: string, versionId: string) Promise~void~
        +updateFile(projectId: string, filePath: string, content: string) Promise~object~
    }
    
    class MinioClient {
        <<external>>
        +putObject(bucket: string, objectName: string, stream: Buffer, size: number, meta: object) Promise~void~
        +getObject(bucket: string, objectName: string, options?: object) Promise~Stream~
        +listObjects(bucket: string, prefix: string, recursive: boolean, options?: object) Promise~Stream~
        +statObject(bucket: string, objectName: string, options?: object) Promise~object~
        +removeObject(bucket: string, objectName: string, options?: object) Promise~void~
        +getBucketVersioning(bucketName: string) Promise~object~
        +setBucketVersioning(bucketName: string, config: object) Promise~void~
    }
    
    class SaveFileCommand {
        <<Command Pattern>>
        -previousVersionId: string
        -currentVersionId: string
        +execute() Promise~void~
        +undo() Promise~void~
        +redo() Promise~void~
    }
    
    %% Relationships
    FileSystemService --> MinIOStorageAdapter : uses
    MinIOStorageAdapter --> FileVersion : creates/retrieves/restores
    MinIOStorageAdapter --> MinioClient : uses
    FileContent --> FileVersion : state captured in
    FileVersion --> FileContent : state restored to
    SaveFileCommand --> MinIOStorageAdapter : uses for undo/redo
    SaveFileCommand --> FileVersion : tracks versions
    
    %% Notes
    note for FileContent "Originator: The file content\nwhose state is saved"
    note for FileVersion "Memento: Immutable version snapshot\nof file state (content + metadata)"
    note for MinIOStorageAdapter "Caretaker: Manages file versions,\ncreates mementos on write,\nrestores state on restoreVersion()"
    note for FileSystemService "Client: Uses adapter to manage\nfile versions (mementos)"
```

